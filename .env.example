# Copy this file to .env and adjust for your environment.
# docker compose reads .env automatically for ${VAR} substitution in docker-compose.yml.

# Runtime environment: development | production
ENVIRONMENT=development

# Logging verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# SQLAlchemy database URL. Relative paths resolve against the process working
# directory. Locally, run from the repository root; docker compose sets an
# absolute container path by default.
DATABASE_URL=sqlite:///./data/orchestrator.db

# Root directory for per-project workspaces (e.g. projects/). Relative paths
# resolve against the process working directory; docker compose sets an
# absolute container path by default.
WORKSPACES_ROOT=projects

# ---- OpenHands Cloud API (Phase 5) ----
# Base URL of the OpenHands Cloud (or compatible) API V1. The default is the
# hosted OpenHands Cloud.
# OPENHANDS_BASE_URL=https://app.all-hands.dev
# API key for the OpenHands Cloud API (create one at
# https://app.all-hands.dev/settings/api-keys). This is a server secret: it
# is never logged, never stored in Agent.configuration, and never returned by
# the API. Leave unset to run with the provider "not configured".
# OPENHANDS_API_KEY=
# Per-request timeout for OpenHands API calls (seconds).
# OPENHANDS_TIMEOUT=30.0
# How long to wait for a started conversation to become READY (seconds).
# OPENHANDS_START_TIMEOUT=120.0
# Interval between status polls (seconds).
# OPENHANDS_POLL_INTERVAL=5.0
# Maximum wall-clock time an execution may run before the orchestrator
# reports a timeout (seconds).
# OPENHANDS_MAX_EXECUTION_SECONDS=3600.0

# PostgreSQL later (Phase 2+): requires a driver, e.g.
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/orchestrator
